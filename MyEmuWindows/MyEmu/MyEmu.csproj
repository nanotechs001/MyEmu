<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyEmu</RootNamespace>
    <AssemblyName>MyEmu</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel, for the MCP endpoint (AI control). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="All" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- AutoPots' detection, rules, fast path and auto-detect, shared with the MuMu AutoPots app. -->
  <ItemGroup>
    <Compile Include="..\AutoPots\Detection.cs;..\AutoPots\Rules.cs;..\AutoPots\Runner.cs;..\AutoPots\Calibration.cs"
             Link="AutoPots\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Game speed's native bridge, installed on the Custom model profile (Android/speed/build.ps1). -->
  <ItemGroup>
    <None Include="Assets\libgpu_tls.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The same engine API the Mac app uses. -->
  <ItemGroup>
    <Protobuf Include="..\..\MyEmu\Sources\MyEmu\emulator_controller.proto" Link="emulator_controller.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
