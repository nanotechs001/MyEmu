<Window x:Class="MyEmu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyEmu"
        Title="MyEmu" Width="1280" Height="760" Background="#111">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#222" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4">
                <ToggleButton x:Name="OptionsButton" Content="Options" Width="72" Margin="2,2,10,2" Focusable="False"
                              Checked="OptionsButton_Toggled" Unchecked="OptionsButton_Toggled"/>
                <Button Content="Back" Width="64" Margin="2" Click="Back_Click" Focusable="False"/>
                <Button Content="Home" Width="64" Margin="2" Click="Home_Click" Focusable="False"/>
                <Button Content="Recents" Width="64" Margin="2" Click="Recents_Click" Focusable="False"/>
            </StackPanel>
            <TextBlock x:Name="Status" Foreground="#ccc" VerticalAlignment="Center" Margin="10,0"/>
        </DockPanel>
        <!-- Key-mapping toolbar while editing (MEmu-style), above the screen. -->
        <Border x:Name="EditorBar" DockPanel.Dock="Top" Background="#1e293b" Visibility="Collapsed" Padding="10,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Width="70" Margin="4,0" Click="CancelKeys_Click" Focusable="False"/>
                    <Button Content="Save" Width="70" Click="SaveKeys_Click" Focusable="False" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Key opacity" Foreground="#e6e6e6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="OpacitySlider" Width="120" Minimum="0.1" Maximum="1" Focusable="False" VerticalAlignment="Center"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                        <Button x:Name="AddJoystickButton" Content="Add WASD joystick" Margin="14,0,0,0" Click="AddJoystick_Click" Focusable="False"/>
                        <TextBlock x:Name="JoystickSizeLabel" Text="Joystick size" Foreground="#e6e6e6" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Slider x:Name="JoystickSlider" Width="120" Minimum="0.04" Maximum="0.2" Focusable="False" VerticalAlignment="Center"
                                ValueChanged="JoystickSlider_ValueChanged"/>
                        <StackPanel x:Name="SelectionRow" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock x:Name="SelectionLabel" Foreground="#e6e6e6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="ModeBox" Width="80" Focusable="False" SelectionChanged="ModeBox_SelectionChanged">
                                <ComboBoxItem Content="Hold"/>
                                <ComboBoxItem Content="Burst"/>
                            </ComboBox>
                            <Button Content="Delete" Margin="6,0,0,0" Click="DeleteSelection_Click" Focusable="False"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock x:Name="EditorHint" Foreground="#9a9a9a" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Docked beside the screen, not over it: the screen is a native child window that WPF can't draw on top of. -->
        <Border x:Name="OptionsPanel" DockPanel.Dock="Right" Width="300" Background="#1b1b1b" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="14,10">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9a9a9a"/><Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
                        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="Foreground" Value="#e6e6e6"/>
                            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,14,0,4"/></Style>
                        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#e6e6e6"/><Setter Property="Focusable" Value="False"/>
                            <Setter Property="Margin" Value="0,4,0,0"/></Style>
                        <Style TargetType="ComboBox"><Setter Property="Focusable" Value="False"/></Style>
                    </StackPanel.Resources>

                    <TextBlock Style="{StaticResource Heading}" Text="Instances" Margin="0,0,0,0"/>
                    <StackPanel x:Name="InstancesPanel"/>
                    <TextBlock x:Name="InstancesBusy" Foreground="#f59e0b" Visibility="Collapsed"/>
                    <Button x:Name="NewInstanceButton" Content="New instance" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="8,2" Focusable="False" Click="NewInstance_Click"/>
                    <TextBlock Text="Each instance is a separate Android with its own apps, sign-ins and data, in its own window. Closing a window stops that Android. Clone copies a stopped one with everything in it."/>

                    <TextBlock Style="{StaticResource Heading}" Text="AI control"/>
                    <CheckBox x:Name="AiControlBox" Content="Allow AI control (MCP)" Click="AiControl_Click"/>
                    <TextBox x:Name="AiControlUrl" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#e6e6e6" FontSize="11"/>
                    <TextBlock x:Name="AiControlNote" Text="AI apps (Claude Code, Codex…) can see the screen, tap, type and open apps through this local address."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Game keys"/>
                    <TextBlock x:Name="KeysApp" Text="Waiting for Android…"/>
                    <CheckBox x:Name="KeysEnabledBox" Content="Use game keys (Ctrl+Shift+G)" Click="KeysEnabled_Click"/>
                    <Button x:Name="EditKeysButton" Content="Edit key mapping (Ctrl+Shift+K)" Margin="0,6,0,0" Click="EditKeys_Click" Focusable="False"/>
                    <TextBlock x:Name="KeysStatus" Foreground="#f59e0b" Visibility="Collapsed"/>
                    <StackPanel x:Name="KeysSettings">
                        <TextBlock x:Name="BurstLabel" Text="Burst speed" Foreground="#e6e6e6" Margin="0,8,0,0"/>
                        <Slider x:Name="BurstSlider" Minimum="2" Maximum="20" SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                Focusable="False" ValueChanged="BurstSlider_ValueChanged" Thumb.DragCompleted="KeySlider_DragCompleted"/>
                        <Button Content="Clear all keys…" Margin="0,6,0,0" Click="ClearKeys_Click" Focusable="False" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Heading}" Text="AutoPots"/>
                    <TextBlock x:Name="PotsStatus" Foreground="#e6e6e6" FontSize="14" FontWeight="SemiBold" Text="Off."/>
                    <TextBlock x:Name="PotsMessage" Foreground="#f59e0b" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Game view" Foreground="#e6e6e6" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="OrbViewBox" Content="Orb" Foreground="#e6e6e6" Margin="0,0,12,0" Focusable="False" Checked="PotsView_Checked"/>
                        <RadioButton x:Name="SimpleViewBox" Content="Simple" Foreground="#e6e6e6" Focusable="False" Checked="PotsView_Checked"/>
                    </StackPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="PotsStartButton" Content="Start (F8)" FontWeight="SemiBold" Padding="8,2" Margin="0,0,6,6" Focusable="False" Click="PotsStart_Click"/>
                        <Button x:Name="PotsDetectButton" Content="Auto-detect (HP full)" Padding="8,2" Margin="0,0,6,6" Focusable="False" Click="PotsDetect_Click"/>
                        <ToggleButton x:Name="PotsAdjustButton" Content="Adjust on screen" Padding="8,2" Margin="0,0,6,6" Focusable="False"
                                      Checked="PotsAdjust_Toggled" Unchecked="PotsAdjust_Toggled"/>
                        <Button x:Name="PotsTemplateButton" Content="Retake template" Padding="8,2" Margin="0,0,6,6" Focusable="False" Click="PotsTemplate_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="PotsConfirmLabel" Foreground="#e6e6e6" FontSize="12"/>
                    <Slider x:Name="PotsConfirmSlider" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="PotsTuning_Changed"/>
                    <TextBlock x:Name="PotsBurstLabel" Foreground="#e6e6e6" FontSize="12"/>
                    <Slider x:Name="PotsBurstSlider" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="PotsTuning_Changed"/>
                    <TextBlock x:Name="PotsPressLabel" Foreground="#e6e6e6" FontSize="12"/>
                    <Slider x:Name="PotsPressSlider" Minimum="0" Maximum="500" IsSnapToTickEnabled="True" TickFrequency="10" Focusable="False" ValueChanged="PotsTuning_Changed"/>
                    <TextBlock x:Name="PotsSpreadLabel" Foreground="#e6e6e6" FontSize="12"/>
                    <Slider x:Name="PotsSpreadSlider" Minimum="0" Maximum="80" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="PotsTuning_Changed"/>
                    <TextBlock Text="Taps your HP potion when HP drops below 90%. Set it up once per game with HP full; F8 starts and stops it from anywhere."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Frame rate"/>
                    <ComboBox x:Name="FpsBox" SelectionChanged="Option_Changed"/>
                    <CheckBox x:Name="MinimizedBox" Content="Drop to 30 fps when minimized" Click="Option_Changed"/>
                    <TextBlock x:Name="FpsNote" Text="Applied instantly, including to the game in front (Android otherwise holds games at 60, Xerion at 55)."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Game render scale"/>
                    <ComboBox x:Name="RenderScaleBox" SelectionChanged="Option_Changed"/>
                    <TextBlock Text="Games draw at this share of the screen and Android scales them up: less GPU, slightly softer. Below 50% text gets blurry. Takes effect when a game next starts."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Super Light"/>
                    <CheckBox x:Name="SuperLightBox" Content="Super Light mode" Click="Option_Changed"/>
                    <TextBlock Text="For farming and many instances: games draw at 10%, 30 fps, Android animations and unused apps off. Off brings your own settings back."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Lightweight Android"/>
                    <CheckBox x:Name="LightweightBox" Content="Switch off unused apps" Click="Option_Changed"/>
                    <TextBlock Text="Turns off 30 Google apps a game emulator doesn't need (Assistant, Wellbeing, Gmail, YouTube…), about 600 MB. Play Store, Chrome, sign-in and the keyboard stay."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Keyboard"/>
                    <CheckBox x:Name="KeyboardOnlyBox" Content="PC keyboard only" Click="Option_Changed"/>
                    <TextBlock Text="Android's on-screen keyboard stays hidden; you type on this PC's keyboard."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Renderer"/>
                    <ComboBox x:Name="RendererBox" SelectionChanged="Option_Changed">
                        <ComboBoxItem Content="Vulkan (less GPU)"/>
                        <ComboBoxItem Content="OpenGL"/>
                    </ComboBox>
                    <TextBlock x:Name="RendererNote" Text="Vulkan ran Xerion at the same fps as OpenGL with about half the GPU. Use OpenGL only if a game draws incorrectly."/>
                    <StackPanel x:Name="GpuPriorityPanel">
                        <CheckBox x:Name="GpuPriorityBox" Content="GPU priority" Margin="0,6,0,0" Click="Option_Changed"/>
                        <TextBlock Text="Runs MyEmu and Android on the dedicated GPU, ahead of other apps for GPU and CPU time, and keeps Windows from slowing them down to save power. The GPU choice applies when Android next starts."/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Heading}" Text="Display"/>
                    <TextBlock x:Name="DisplayCurrent" Text="Available once Android has started."/>
                    <ComboBox x:Name="OrientationBox" Margin="0,4,0,0" SelectionChanged="Display_Changed">
                        <ComboBoxItem Content="Landscape"/>
                        <ComboBoxItem Content="Portrait"/>
                    </ComboBox>
                    <ComboBox x:Name="ResolutionBox" Margin="0,4,0,0" SelectionChanged="Display_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="W" Margin="0,3,4,0"/><TextBox x:Name="WidthBox" Width="52" LostFocus="DisplaySize_Changed" KeyDown="Number_KeyDown"/>
                        <TextBlock Text="H" Margin="8,3,4,0"/><TextBox x:Name="HeightBox" Width="52" LostFocus="DisplaySize_Changed" KeyDown="Number_KeyDown"/>
                        <TextBlock Text="DPI" Margin="8,3,4,0"/><TextBox x:Name="DensityBox" Width="40" LostFocus="DisplaySize_Changed" KeyDown="Number_KeyDown"/>
                    </StackPanel>
                    <TextBlock Text="Game-key positions scale with the screen, so your mapping keeps working."/>

                    <TextBlock Style="{StaticResource Heading}" Text="Device"/>
                    <TextBlock x:Name="DeviceCurrent"/>
                    <ComboBox x:Name="ProfileBox" Margin="0,4,0,0" SelectionChanged="Device_Changed">
                        <ComboBoxItem Content="Play Store"/>
                        <ComboBoxItem Content="Custom model"/>
                    </ComboBox>
                    <TextBlock x:Name="ProfileNote"/>
                    <StackPanel x:Name="CustomModelPanel">
                        <ComboBox x:Name="ModelBox" Margin="0,6,0,0" SelectionChanged="Device_Changed"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Name" Margin="0,3,0,0"/><TextBox x:Name="MarketNameBox" Grid.Column="1" Margin="0,1" LostFocus="DeviceText_Changed" KeyDown="Number_KeyDown"/>
                            <TextBlock Grid.Row="1" Text="Brand" Margin="0,3,0,0"/><TextBox x:Name="BrandBox" Grid.Row="1" Grid.Column="1" Margin="0,1" LostFocus="DeviceText_Changed" KeyDown="Number_KeyDown"/>
                            <TextBlock Grid.Row="2" Text="Maker" Margin="0,3,0,0"/><TextBox x:Name="MakerBox" Grid.Row="2" Grid.Column="1" Margin="0,1" LostFocus="DeviceText_Changed" KeyDown="Number_KeyDown"/>
                            <TextBlock Grid.Row="3" Text="Model" Margin="0,3,0,0"/><TextBox x:Name="ModelNameBox" Grid.Row="3" Grid.Column="1" Margin="0,1" LostFocus="DeviceText_Changed" KeyDown="Number_KeyDown"/>
                            <TextBlock Grid.Row="4" Text="Phone" Margin="0,3,0,0"/><TextBox x:Name="PhoneBox" Grid.Row="4" Grid.Column="1" Margin="0,1" LostFocus="DeviceText_Changed" KeyDown="Number_KeyDown"/>
                            <TextBlock Grid.Row="5" Text="IMEI" Margin="0,3,0,0"/>
                            <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,1">
                                <Button DockPanel.Dock="Right" Content="Random" Margin="4,0,0,0" Padding="6,0" Focusable="False" Click="RandomImei_Click" ToolTip="A random valid IMEI"/>
                                <TextBox x:Name="ImeiBox" LostFocus="DeviceText_Changed" KeyDown="Number_KeyDown"/>
                            </DockPanel>
                        </Grid>
                        <TextBlock Text="Apps read these as the phone's name, Build.BRAND, Build.MANUFACTURER and Build.MODEL. Phone: the SIM's number; IMEI: shown in About phone. Empty for the defaults."/>
                    </StackPanel>
                    <Border x:Name="DeviceApplyBox" Background="#1e293b" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DeviceApplyNote"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="DeviceApplyButton" Content="Apply" FontWeight="SemiBold" Padding="8,2" Focusable="False" Click="DeviceApply_Click"/>
                                <Button Content="Revert" Margin="6,0,0,0" Padding="8,2" Focusable="False" Click="DeviceRevert_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Heading}" Text="Game speed"/>
                    <ComboBox x:Name="SpeedBox" SelectionChanged="Speed_Changed"/>
                    <TextBlock x:Name="SpeedNote"/>

                    <TextBlock Style="{StaticResource Heading}" Text="CPU &amp; memory"/>
                    <ComboBox x:Name="PerformanceBox" SelectionChanged="Display_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Cores" Margin="0,3,4,0"/><ComboBox x:Name="CoresBox" Width="50" SelectionChanged="Display_Changed"/>
                        <TextBlock Text="Memory" Margin="10,3,4,0"/><ComboBox x:Name="MemoryBox" Width="64" ItemStringFormat="{}{0} GB" SelectionChanged="Display_Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="SuggestedNote"/>
                    <Button x:Name="SuggestedButton" Content="Use suggested" Margin="0,4,0,0" HorizontalAlignment="Left" Padding="8,2" Focusable="False" Click="Suggested_Click"/>

                    <Border x:Name="ApplyBox" Background="#1e293b" Padding="8" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ApplyNote" Text="Android restarts to apply this (about 30 seconds)."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="ApplyButton" Content="Apply &amp; Restart" FontWeight="SemiBold" Padding="8,2" Focusable="False" Click="Apply_Click"/>
                                <Button Content="Revert" Margin="6,0,0,0" Padding="8,2" Focusable="False" Click="Revert_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid x:Name="ScreenArea" Background="Black" SizeChanged="ScreenArea_SizeChanged"
              MouseLeftButtonDown="Screen_MouseDown" MouseMove="Screen_MouseMove" MouseLeftButtonUp="Screen_MouseUp">
            <local:D3DScreen x:Name="Screen" HorizontalAlignment="Center" VerticalAlignment="Center" Width="0" Height="0"/>
        </Grid>
    </DockPanel>
</Window>
