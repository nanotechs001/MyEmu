<Window x:Class="MyEmu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyEmu"
        Title="MyEmu" Width="1280" Height="760" Background="#111">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#222" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="4">
                <Button Content="Back" Width="64" Margin="2" Click="Back_Click" Focusable="False"/>
                <Button Content="Home" Width="64" Margin="2" Click="Home_Click" Focusable="False"/>
                <Button Content="Recents" Width="64" Margin="2" Click="Recents_Click" Focusable="False"/>
            </StackPanel>
            <TextBlock x:Name="Status" Foreground="#ccc" VerticalAlignment="Center" Margin="10,0"/>
        </DockPanel>
        <Grid x:Name="ScreenArea" Background="Black" SizeChanged="ScreenArea_SizeChanged"
              MouseLeftButtonDown="Screen_MouseDown" MouseMove="Screen_MouseMove" MouseLeftButtonUp="Screen_MouseUp">
            <local:D3DScreen x:Name="Screen" HorizontalAlignment="Center" VerticalAlignment="Center" Width="0" Height="0"/>
        </Grid>
    </DockPanel>
</Window>
